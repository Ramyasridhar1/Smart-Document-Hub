# Smart Document Hub bootstrap environment template
# This file is copied to /var/lib/smartdoc/runtime.env on first container start.
# Secret placeholders are auto-generated by docker-entrypoint.sh.

# Security
FLASK_SECRET_KEY=__GENERATE__
SETTINGS_ENCRYPTION_KEY=__GENERATE__

# Admin bootstrap
ADMIN_USER=admin
ADMIN_PASS=__GENERATE_ADMIN_PASS__

# App routing and runtime
UPLOAD_FOLDER=/var/lib/smartdoc/uploads
DATABASE_URL=postgresql://smartdoc:smartdoc@db:5432/smartdoc
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=0

# Inbound adapter
INBOUND_ADAPTER=hybrid
WEBHOOK_SHARED_SECRET=

# OCR and extraction
ENABLE_OCR=0
OCR_DPI=200
EXTRACT_MAX_TEXT_BYTES=50000
EXTRACT_PDF_MAX_PAGES=10

# Classification and routing
AUTO_ROUTE_CONFIDENCE_THRESHOLD=0.75
AUTO_ROUTE_THRESHOLD_INVOICE=
AUTO_ROUTE_THRESHOLD_PAYSLIP=
AUTO_ROUTE_THRESHOLD_PURCHASE_ORDER=
AUTO_ROUTE_THRESHOLD_MINUTES=
AUTO_ROUTE_THRESHOLD_RESUME=
AUTO_ROUTE_THRESHOLD_OTHER=
ROUTE_LOCAL_ENABLED=1
ROUTE_EMAIL_ENABLED=1

# Email and IMAP (optional)
EMAIL_USER=
EMAIL_PASS=
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=
IMAP_SKIP_EXISTING_UNSEEN=1
IMAP_ALLOWED_SENDERS=
IMAP_SUBJECT_KEYWORD=
FROM_NAME=Smart Document Hub
ADMIN_EMAIL=

# Category routing emails (optional)
ROUTE_invoice=
ROUTE_payslip=
ROUTE_purchase_order=
ROUTE_minutes=
ROUTE_resume=

# Resume ranking
ENABLE_RESUME_RANKER=0
RANKER_MIN_FIT_SCORE=60
RESUME_REQUIRED_SKILLS=python
RESUME_PREFERRED_SKILLS=
RESUME_CERTIFICATE_BONUS=10
RESUME_PROJECT_BONUS=10

# Logging
LOG_FILE_PATH=/var/lib/smartdoc/logs/smart_document_hub.log
LOG_LEVEL=INFO
